{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed", "on_shelf", "head"],
        "model": { "type": "minecraft:model", "model": "witchery:item/hand_bow" }
      }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "witchery:hand_bow_charged",
      "entries": [
        {
          "threshold": 1.0,
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "witchery:hand_bow_pulling",
            "entries": [
              {
                "threshold": 1.0,
                "model": {
                  "type": "minecraft:special",
                  "base": "witchery:item/hand_bow_in_hand_base",
                  "model": { "type": "witchery:hand_bow_held", "stage": 2, "pulling": true }
                }
              }
            ],
            "fallback": {
              "type": "minecraft:special",
              "base": "witchery:item/hand_bow_in_hand_base",
              "model": { "type": "witchery:hand_bow_held", "stage": 2 }
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:range_dispatch",
        "property": "witchery:hand_bow_pulling",
        "entries": [
          {
            "threshold": 1.0,
            "model": {
              "type": "minecraft:range_dispatch",
              "property": "witchery:hand_bow_pull",
              "entries": [
                {
                  "threshold": 0.3,
                  "model": {
                    "type": "minecraft:special",
                    "base": "witchery:item/hand_bow_in_hand_base",
                    "model": { "type": "witchery:hand_bow_held", "stage": 1, "pulling": true }
                  }
                },
                {
                  "threshold": 0.55,
                  "model": {
                    "type": "minecraft:special",
                    "base": "witchery:item/hand_bow_in_hand_base",
                    "model": { "type": "witchery:hand_bow_held", "stage": 2, "pulling": true }
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:special",
                "base": "witchery:item/hand_bow_in_hand_base",
                "model": { "type": "witchery:hand_bow_held", "stage": 0, "pulling": true }
              }
            }
          }
        ],
        "fallback": {
          "type": "minecraft:special",
          "base": "witchery:item/hand_bow_in_hand_base",
          "model": { "type": "witchery:hand_bow_held", "stage": 0 }
        }
      }
    }
  }
}
