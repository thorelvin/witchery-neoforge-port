{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui"
        ],
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "witchery:wooden_scanner_using",
          "entries": [
            {
              "threshold": 1.0,
              "model": {
                "type": "minecraft:model",
                "model": "witchery:item/wooden_scanner_active"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "witchery:item/wooden_scanner"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "witchery:wooden_scanner_using",
      "entries": [
        {
          "threshold": 1.0,
          "model": {
            "type": "minecraft:model",
            "model": "witchery:item/wooden_scanner_3d_active"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "witchery:item/wooden_scanner_3d"
      }
    }
  }
}
