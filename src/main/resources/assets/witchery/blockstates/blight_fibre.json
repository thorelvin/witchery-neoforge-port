{
  "multipart": [
    {
      "when": { "north": true },
      "apply": [
        { "model": "witchery:block/blight_fibre" },
        { "model": "witchery:block/blight_fibre_90" },
        { "model": "witchery:block/blight_fibre_180" },
        { "model": "witchery:block/blight_fibre_270" }
      ]
    },
    {
      "when": { "east": true },
      "apply": [
        { "model": "witchery:block/blight_fibre", "uvlock": true, "y": 90 },
        { "model": "witchery:block/blight_fibre_90", "uvlock": true, "y": 90 },
        { "model": "witchery:block/blight_fibre_180", "uvlock": true, "y": 90 },
        { "model": "witchery:block/blight_fibre_270", "uvlock": true, "y": 90 }
      ]
    },
    {
      "when": { "south": true },
      "apply": [
        { "model": "witchery:block/blight_fibre", "uvlock": true, "y": 180 },
        { "model": "witchery:block/blight_fibre_90", "uvlock": true, "y": 180 },
        { "model": "witchery:block/blight_fibre_180", "uvlock": true, "y": 180 },
        { "model": "witchery:block/blight_fibre_270", "uvlock": true, "y": 180 }
      ]
    },
    {
      "when": { "west": true },
      "apply": [
        { "model": "witchery:block/blight_fibre", "uvlock": true, "y": 270 },
        { "model": "witchery:block/blight_fibre_90", "uvlock": true, "y": 270 },
        { "model": "witchery:block/blight_fibre_180", "uvlock": true, "y": 270 },
        { "model": "witchery:block/blight_fibre_270", "uvlock": true, "y": 270 }
      ]
    },
    {
      "when": { "up": true },
      "apply": [
        { "model": "witchery:block/blight_fibre", "uvlock": true, "x": 270 },
        { "model": "witchery:block/blight_fibre_90", "uvlock": true, "x": 270 },
        { "model": "witchery:block/blight_fibre_180", "uvlock": true, "x": 270 },
        { "model": "witchery:block/blight_fibre_270", "uvlock": true, "x": 270 }
      ]
    }
  ]
}
