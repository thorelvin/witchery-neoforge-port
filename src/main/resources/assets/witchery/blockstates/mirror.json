{
  "multipart": [
    { "when": { "facing": "north", "part": "foot" }, "apply": { "model": "witchery:block/bottom_mirror" } },
    { "when": { "facing": "south", "part": "foot" }, "apply": { "model": "witchery:block/bottom_mirror", "y": 180 } },
    { "when": { "facing": "west", "part": "foot" },  "apply": { "model": "witchery:block/bottom_mirror", "y": 90 } },
    { "when": { "facing": "east", "part": "foot" },  "apply": { "model": "witchery:block/bottom_mirror", "y": 270 } },
    { "when": { "facing": "north", "part": "head" }, "apply": { "model": "witchery:block/top_mirror" } },
    { "when": { "facing": "south", "part": "head" }, "apply": { "model": "witchery:block/top_mirror", "y": 180 } },
    { "when": { "facing": "west", "part": "head" },  "apply": { "model": "witchery:block/top_mirror", "y": 90 } },
    { "when": { "facing": "east", "part": "head" },  "apply": { "model": "witchery:block/top_mirror", "y": 270 } }
  ]
}
