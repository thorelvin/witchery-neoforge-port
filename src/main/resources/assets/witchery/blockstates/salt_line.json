{
  "multipart": [
    {
      "when": {
        "OR": [
          { "east": "none", "north": "none", "south": "none", "west": "none" },
          { "east": "side|up", "north": "side|up" },
          { "east": "side|up", "south": "side|up" },
          { "south": "side|up", "west": "side|up" },
          { "north": "side|up", "west": "side|up" }
        ]
      },
      "apply": { "model": "witchery:block/salt_line_dot" }
    },
    { "when": { "north": "side|up" }, "apply": { "model": "witchery:block/salt_line_side0" } },
    { "when": { "east": "side|up" },  "apply": { "model": "witchery:block/salt_line_side_alt1", "y": 270 } },
    { "when": { "south": "side|up" }, "apply": { "model": "witchery:block/salt_line_side_alt0" } },
    { "when": { "west": "side|up" },  "apply": { "model": "witchery:block/salt_line_side1", "y": 270 } },
    { "when": { "north": "up" }, "apply": { "model": "witchery:block/salt_line_up" } },
    { "when": { "east": "up" },  "apply": { "model": "witchery:block/salt_line_up", "y": 90 } },
    { "when": { "south": "up" }, "apply": { "model": "witchery:block/salt_line_up", "y": 180 } },
    { "when": { "west": "up" },  "apply": { "model": "witchery:block/salt_line_up", "y": 270 } }
  ]
}
