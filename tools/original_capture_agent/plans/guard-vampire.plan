# Controlled idle views for the original Village Guard and Vampire models.
OUTPUT C:\claude\witchery\captures\legacy-model-parity\original
LOAD WitcheryParityClean|Witchery Parity Clean
WAIT_WORLD 60000
NO_PAUSE
CLEAR_SCREEN
HIDE_GUI true
GAMMA 1.0
FOV 70
THIRD_PERSON 0
WAIT 3000
COMMAND /gamerule doDaylightCycle false
COMMAND /gamerule doMobSpawning false
COMMAND /difficulty 2
COMMAND /time set 18000
COMMAND /weather clear

COMMAND /tp 700.5 4 -8.5
WAIT 1000
LOOK 0 0
CLEAR_ENTITIES com.emoniph.witchery.entity.EntityVillageGuard
COMMAND /summon witchery.villageguard 700.5 4 0.5 {Silent:1b,NoAI:1b,Rotation:[0f,0f]}
WAIT_ENTITY com.emoniph.witchery.entity.EntityVillageGuard 5000
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityVillageGuard 700.5 4 0.5 0 0 entity-village_guard-yaw0.png
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityVillageGuard 700.5 4 0.5 180 0 entity-village_guard-yaw180.png

COMMAND /tp 800.5 4 -8.5
WAIT 1000
LOOK 0 0
CLEAR_ENTITIES com.emoniph.witchery.entity.EntityVampire
COMMAND /summon witchery.vampire 800.5 4 0.5 {Silent:1b,NoAI:1b,Rotation:[0f,0f]}
WAIT_ENTITY com.emoniph.witchery.entity.EntityVampire 5000
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityVampire 800.5 4 0.5 0 0 entity-vampire-yaw0.png
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityVampire 800.5 4 0.5 180 0 entity-vampire-yaw180.png
