# Controlled idle views for high-risk original Witchery entity models.
OUTPUT C:\claude\witchery\captures\legacy-model-parity\original
LOAD WitcheryParityClean|Witchery Parity Clean
WAIT_WORLD 60000
NO_PAUSE
CLEAR_SCREEN
HIDE_GUI true
GAMMA 1.0
FOV 70
THIRD_PERSON 0
WAIT 3000
COMMAND /gamerule doDaylightCycle false
COMMAND /gamerule doMobSpawning false
COMMAND /difficulty 2
COMMAND /tp 0.5 4 -8.5
COMMAND /time set 6000
COMMAND /weather clear
WAIT 3000
LOOK 0 0

CLEAR_ENTITIES com.emoniph.witchery.entity.EntityImp
COMMAND /summon witchery.imp 0.5 4 0.5 {Silent:1b,Rotation:[0f,0f]}
WAIT_ENTITY com.emoniph.witchery.entity.EntityImp 5000
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityImp 0.5 4 0.5 0 0 entity-flame_imp-yaw0.png
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityImp 0.5 4 0.5 180 0 entity-flame_imp-yaw180.png

COMMAND /tp 100.5 4 -8.5
WAIT 1000
LOOK 0 0
CLEAR_ENTITIES com.emoniph.witchery.entity.EntityDeath
COMMAND /summon witchery.death 100.5 4 0.5 {Silent:1b,Rotation:[0f,0f]}
WAIT_ENTITY com.emoniph.witchery.entity.EntityDeath 5000
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityDeath 100.5 4 0.5 0 0 entity-death-yaw0.png
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityDeath 100.5 4 0.5 180 0 entity-death-yaw180.png

