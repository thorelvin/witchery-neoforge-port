# Smoke test for the original-client capture path.
OUTPUT C:\claude\witchery\captures\legacy-model-parity\original
LOAD WitcheryParityQA|Witchery Parity QA
WAIT_WORLD 60000
NO_PAUSE
CLEAR_SCREEN
HIDE_GUI true
GAMMA 1.0
FOV 70
THIRD_PERSON 0
WAIT 3000
