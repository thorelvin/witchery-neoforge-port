# Controlled two-angle captures for source-model families not covered by the high-risk batch.
OUTPUT C:\claude\witchery\captures\legacy-model-parity\original
LOAD WitcheryParityClean|Witchery Parity Clean
WAIT_WORLD 60000
NO_PAUSE
CLEAR_SCREEN
HIDE_GUI true
GAMMA 1.0
FOV 70
THIRD_PERSON 0
WAIT 3000
COMMAND /gamerule doDaylightCycle false
COMMAND /gamerule doMobSpawning false
COMMAND /gamemode 1
COMMAND /time set 6000
COMMAND /weather clear
LOOK 0 0

COMMAND /tp 1100.5 4 -8.5
CLEAR_ENTITIES com.emoniph.witchery.entity.EntityMandrake
COMMAND /summon witchery.mandrake 1100.5 4 0.5 {Silent:1b,Rotation:[0f,0f]}
WAIT_ENTITY com.emoniph.witchery.entity.EntityMandrake 5000
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityMandrake 1100.5 4 0.5 0 0 entity-mandrake_mob-yaw0.png
STABILIZE_CAPTURE com.emoniph.witchery.entity.EntityMandrake 1100.5 4 0.5 180 0 entity-mandrake_mob-yaw180.png

